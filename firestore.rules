rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The signed-in address in lowercase, only when Google has verified it; null otherwise. Addresses are compared
    // case-insensitively: the token's address is lowercased here and config/admins stores lowercase addresses
    // (the admin page lowercases on save, and the rules below refuse anything else).
    function mail() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email is string ? request.auth.token.email.lower() : null;
    }
    function isOwner() {
      return mail() == 'yusufhamdy20@gmail.com';
    }
    function isAdmin() {
      // no exists() first: a missing list makes get() fail, which refuses just the same, and a save with its history
      // has to stay inside Firestore's limit of 20 document lookups per transaction
      return isOwner() || (mail() != null
        && mail() in get(/databases/$(database)/documents/config/admins).data.emails);
    }

    // --- document shapes (what the admin page writes; Firestore itself caps a document at 1 MiB) ---
    // public/data: the words list, written with its revision, time and author (the writer's Firebase uid: this
    // document is public, so it never carries an address)
    function validWords(d) {
      return d.keys().hasAll(['rev', 'surahs']) && d.keys().hasOnly(['rev', 'surahs', 'updatedAt', 'by'])
        && d.rev is int && d.rev >= 0
        && d.surahs is list && d.surahs.size() <= 114
        && (!('updatedAt' in d) || d.updatedAt is timestamp)
        && (!('by' in d) || (d.by is string && d.by == request.auth.uid));
    }
    // public/prev: the last copy from before the version history. The admin page no longer writes it; it stays as a last resort.
    function validPrev(d) {
      return d.keys().hasAll(['rev', 'surahs']) && d.keys().hasOnly(['rev', 'surahs', 'savedAt'])
        && d.rev is int && d.rev >= 0
        && d.surahs is list && d.surahs.size() <= 114
        && (!('savedAt' in d) || d.savedAt is timestamp);
    }
    // public/challenge: start date, released day and the days
    function validChallenge(d) {
      return d.keys().hasAll(['days']) && d.keys().hasOnly(['startDate', 'releasedUpTo', 'days'])
        && (!('startDate' in d) || d.startDate == null || (d.startDate is string && d.startDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
        && (!('releasedUpTo' in d) || d.releasedUpTo == null || (d.releasedUpTo is int && d.releasedUpTo >= 0 && d.releasedUpTo <= 366))
        && d.days is list && d.days.size() <= 366;
    }
    // admin/challengeNotes: day number -> note text (join fails, and so denies, on any non-string value)
    function validNotes(d) {
      return d.keys().size() <= 366
        && (d.keys().size() == 0 || d.keys().join(',').matches('[0-9]{1,3}(,[0-9]{1,3})*'))
        && d.values().join('').size() <= 200000;
    }
    // config/admins: lowercase e-mail addresses only
    function validAdmins(d) {
      return d.keys().hasOnly(['emails']) && d.emails is list && d.emails.size() <= 50
        && d.emails.join(' ') == d.emails.join(' ').lower()
        && (d.emails.size() == 0 || d.emails.join(' ').matches('[^@ ]+@[^@ ]+[.][^@ ]+( [^@ ]+@[^@ ]+[.][^@ ]+)*'));
    }

    // --- version history of public/data: snapshots/{rev} (the full words) and history/{rev} (the list's metadata) ---
    // Both are create-only and written in the same transaction as the save of public/data they record.
    function dataDoc() { return /databases/$(database)/documents/public/data; }
    function snapDoc(r) { return /databases/$(database)/documents/snapshots/$(string(r)); }
    function histDoc(r) { return /databases/$(database)/documents/history/$(string(r)); }
    // public/data: every save moves the revision up by exactly one, names its writer and time, and records itself. The
    // version it replaces must have its record too (the first save after release adds that record as the baseline).
    function savedWithHistory() {
      let d = request.resource.data;
      return d.by == request.auth.uid && d.updatedAt == request.time
        && (resource == null ? d.rev == 1 : d.rev == resource.data.rev + 1 && existsAfter(histDoc(resource.data.rev)))
        && existsAfter(histDoc(d.rev))
        && getAfter(snapDoc(d.rev)).data.surahs == d.surahs;
    }
    // A save with its baseline writes five documents, and a transaction has 20 document lookups: each lookup below is made
    // once for each write, its result bound with let (or passed in) wherever a write needs it twice.
    // this request moves public/data to revision r (after = public/data after it): at r after it, at r - 1 before it
    function movesDataTo(r, after) {
      return after.data.rev == r
        && (r == 1 && !exists(dataDoc()) || get(dataDoc()).data.rev == r - 1);
    }
    // the baseline: the revision and words public/data holds now, before this request
    function isCurrentData(r, surahs) {
      let now = get(dataDoc());
      return now.data.rev == r && now.data.surahs == surahs;
    }
    // the words of a save's version: the same words public/data holds after the request
    function snapshotOfSave(d) {
      let after = getAfter(dataDoc());
      return movesDataTo(d.rev, after) && d.surahs == after.data.surahs;
    }
    // a version is written with its history row: the row says whether it is a save or the baseline
    function snapshotRecorded(d) {
      let kind = getAfter(histDoc(d.rev)).data.kind;
      return kind == 'baseline' ? isCurrentData(d.rev, d.surahs) : snapshotOfSave(d);
    }
    function validSnapshot(id, d) {
      return d.keys().hasAll(['rev', 'surahs']) && d.keys().hasOnly(['rev', 'surahs'])
        && d.rev is int && d.rev >= 0 && id == string(d.rev)
        && d.surahs is list && d.surahs.size() <= 114;
    }
    function validHistory(id, d) {
      return d.keys().hasAll(['rev', 'kind', 'summary', 'by', 'byEmail', 'at'])
        && d.keys().hasOnly(['rev', 'kind', 'summary', 'by', 'byEmail', 'at', 'restoredFrom'])
        && d.rev is int && d.rev >= 0 && id == string(d.rev)
        && d.kind in ['edit', 'import', 'restore', 'baseline']
        && d.summary is string && d.summary.size() <= 300
        && d.by == request.auth.uid
        && d.byEmail == request.auth.token.email
        && d.at == request.time
        && (d.kind == 'restore') == ('restoredFrom' in d)
        && (!('restoredFrom' in d) || (d.restoredFrom is int && d.restoredFrom >= 0 && d.restoredFrom < d.rev));
    }

    // Working copies of the site's data: only admins read them (visitors get the published words.json and challenge.json
    // from Hosting); admins write only the three known documents, in their shapes; nobody deletes.
    match /public/{doc} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && (
        (doc == 'data' && validWords(request.resource.data) && savedWithHistory())
        || (doc == 'prev' && validPrev(request.resource.data))
        || (doc == 'challenge' && validChallenge(request.resource.data)));
      allow delete: if false;
    }
    // The version history: admins read and add; nobody changes or deletes a version, not even the owner.
    match /snapshots/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validSnapshot(id, request.resource.data) && snapshotRecorded(request.resource.data);
      allow update, delete: if false;
    }
    match /history/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validHistory(id, request.resource.data) && (
        request.resource.data.kind == 'baseline'
          ? isCurrentData(request.resource.data.rev, getAfter(snapDoc(request.resource.data.rev)).data.surahs)
          : movesDataTo(request.resource.data.rev, getAfter(dataDoc())) && existsAfter(snapDoc(request.resource.data.rev)));
      allow update, delete: if false;
    }

    // The admins list: admins read it; only the owner changes it.
    match /config/admins {
      allow read: if isAdmin();
      allow create, update: if isOwner() && validAdmins(request.resource.data);
      allow delete: if isOwner();
    }

    // Private per-day challenge notes. Admin-only: readable and writable by
    // admins, never exposed to the public site or visitors.
    match /admin/challengeNotes {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validNotes(request.resource.data);
      allow delete: if isOwner();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
