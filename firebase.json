{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "/admin/**", "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" } ] },
      { "source": "/sw.js", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
      { "source": "/firebase-config.js", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] }
    ],
    "rewrites": [
      { "source": "/word/**", "function": { "functionId": "seo", "region": "europe-west1" } },
      { "source": "/sitemap.xml", "function": { "functionId": "seo", "region": "europe-west1" } }
    ]
  },
  "firestore": { "rules": "firestore.rules" },
  "functions": [ { "source": "functions", "codebase": "default" } ]
}
