{
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "^12.6.0",
    "firebase-tools": "^15.33.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/amiri-quran": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "playwright": "^1.49.0"
  },
  "scripts": {
    "rules:test": "firebase emulators:exec --project demo-ghareeb --only firestore \"node --test test/rules-emulator.test.js\"",
    "seed": "firebase emulators:exec --project demo-ghareeb --only firestore \"node scripts/seed-emulator.js\"",
    "client:verify": "firebase emulators:exec --project demo-ghareeb --only firestore \"node scripts/seed-emulator.js && node scripts/verify-client-firestore.mjs\"",
    "test": "node --test --test-concurrency=2 --test-timeout=600000",
    "csp:update": "node scripts/csp-update.mjs"
  }
}
