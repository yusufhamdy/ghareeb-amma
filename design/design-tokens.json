{
 "_note": "Values are exact and match design/design-spec.html and reference/app. Colors are [background, accent, tile/blob 1, companion/blob 2].",
 "breakpoints": {
  "mobile": "0-600px",
  "tablet": "601-1024px",
  "desktop": "1025px and up"
 },
 "specViewports": {
  "mobile": 400,
  "tablet": 820,
  "desktop": 1440
 },
 "typography": {
  "quran": "KFGQPC Uthmanic Hafs (fallback Amiri Quran)",
  "ui": "IBM Plex Sans Arabic 400/500/600",
  "mono": "IBM Plex Mono 400/500 (numerals and small labels in the shade style)",
  "shadeHeadings": "Amiri Quran 400, clamp(34px,7vw,60px), line-height 1.35",
  "h1": "clamp(26px,5vw,34px) 600 line-height 1.3 (glass)",
  "wordHeading": "clamp(44px,9vw,64px) line-height 1.5",
  "ayah": "clamp(22px,4vw,28px) line-height 2.1",
  "body": "15-19px line-height 1.7",
  "small": "12-13px"
 },
 "layout": {
  "pageGap": 18,
  "pagePaddingMobile": "24px top, 20px sides",
  "pagePaddingTablet": "32px sides",
  "contentMaxWidth": {
   "mobile": "100%",
   "tablet": 760,
   "desktop": 1080
  },
  "desktopTopPadding": 100,
  "cardPadding": 22,
  "cardRadius": {
   "glass": 24,
   "shade": 26
  },
  "searchHeight": 54,
  "searchRadius": 27,
  "rowMinHeight": 60,
  "quizOptionGap": 12,
  "colsGap": 16,
  "minTouchTarget": 44
 },
 "nav": {
  "height": 64,
  "width": "min(440px, 100% - 40px)",
  "offset": {
   "mobile": "bottom 20px",
   "tablet": "bottom 20px",
   "desktop": "top 18px"
  },
  "innerPadding": 6,
  "tabs": 4,
  "indicator": "solid accent (shade: text color) pill, moves with transform translateX(i * -100%) , 450ms cubic-bezier(.34,1.4,.64,1)",
  "press": "scale(.9)",
  "activeIcon": "stroke 2.3 + 18% white fill + 400ms pop (scale 1.2 at 40%)",
  "hideOnScrollDown": "translateY(120px) (desktop: -120px) after 140px scroll",
  "dot": "10px #d4553f on the challenge tab when a released day was not seen",
  "haptic": "navigator.vibrate(8) where supported",
  "pageTransitions": "tabs: fade 250ms; detail pages: slide from left 18px 300ms"
 },
 "glass": {
  "blurPx": {
   "light": 8,
   "medium": 22,
   "strong": 36
  },
  "saturate": "160%",
  "day": {
   "bg": "rgba(255,255,255,.5)",
   "border": "rgba(255,255,255,.85)"
  },
  "night": {
   "bg": "rgba(255,255,255,.08)",
   "border": "rgba(255,255,255,.22)"
  },
  "shadow": "inset 0 1px 0 rgba(255,255,255,.4), 0 10px 30px rgba(0,0,0,.15)",
  "blobs": "two blurred circles 320px and 300px, blur 70px, opacity .8 and .7, slow drift 26s/30s"
 },
 "shade": {
  "surface": {
   "night": "mix(bg, #ffffff, 7%)",
   "day": "mix(bg, #ffffff, 55%)"
  },
  "surfaceBorder": {
   "night": "rgba(255,255,255,.08)",
   "day": "rgba(29,43,37,.1)"
  },
  "noBlurNoShadow": true,
  "tileRadius": 26,
  "dayTileRadius": 16,
  "wordCardFade": "linear-gradient(180deg, tile 0, mix(tile 38%, surface) 42px, surface 90px); padding-top 96px (desktop: 52px/110px, padding-top 118px)",
  "glowBlobs": "ellipse 140% x 46% top, blur 46px; orb 300px bottom-left opacity .55; both use the tile color",
  "tileImages": "design/tile-patterns (6 per palette per mode, pattern = hash(id) % 6)"
 },
 "challengeStates": {
  "done": "filled/tile image + small check badge, still openable",
  "available": "plain, openable",
  "today": "accent ring + glow",
  "locked": "dimmed + lock badge, tap shows toast; number always visible"
 },
